{
    "name": "rafael-minuesa/rest-posts-embedder",
    "description": "Embed remote WordPress posts using a shortcode.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^1.1"
    },
    "config": {
        "platform": { "php": "7.4.33" },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "test:random": "phpunit --order-by=random",
        "test:multisite": [
            "@putenv WP_MULTISITE=1",
            "phpunit"
        ],
        "test:no-mbstring": "@php -d disable_functions=mb_strlen,mb_substr,mb_strrpos vendor/bin/phpunit"
    }
}
