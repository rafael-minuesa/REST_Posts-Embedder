# Front-end byline date format. English drops to a plain Spanish date.
# msgid runtime:  jS \of F Y   ->  "8th of June 2026"
# msgstr runtime: j \d\e F Y   ->  "8 de junio 2026"
msgctxt "embedded post date format"
msgid "jS \\of F Y"
msgstr "j \\d\\e F Y"

msgid "%1$s, by %2$s"
msgstr "%1$s, por %2$s"

msgid "Unknown Author"
msgstr "Autor desconocido"

msgid "Untitled"
msgstr "Sin título"

msgid "Read more..."
msgstr "Leer más..."

msgid "Settings"
msgstr "Ajustes"

msgid "Default Source"
msgstr "Fuente predeterminada"

msgid "Invalid endpoint URL."
msgstr "URL del endpoint no válida."

msgid "No posts found."
msgstr "No se han encontrado entradas."

msgid "Unable to parse response from API. Invalid JSON received."
msgstr "No se ha podido procesar la respuesta de la API. JSON no válido."

msgid "Unable to fetch posts. Error: %s. Please check your endpoint URL in the plugin settings."
msgstr "No se han podido obtener las entradas. Error: %s. Comprueba la URL del endpoint en los ajustes del plugin."

msgid "Unable to fetch posts. Server returned HTTP error %d. Please verify the endpoint URL is correct."
msgstr "No se han podido obtener las entradas. El servidor devolvió el error HTTP %d. Verifica que la URL del endpoint sea correcta."

msgid "The requested feed source \"%s\" is currently disabled."
msgstr "La fuente solicitada «%s» está desactivada actualmente."

msgid "Feed source \"%s\" not found. Please check your source ID in the plugin settings."
msgstr "No se ha encontrado la fuente «%s». Comprueba el ID de la fuente en los ajustes del plugin."

# --- 3.7.0: Load More button ---
msgid "Load More"
msgstr "Cargar más"

msgid "Loading…"
msgstr "Cargando…"

msgid "Could not load more posts. Please try again."
msgstr "No se han podido cargar más entradas. Inténtalo de nuevo."

msgid "This feed has expired. Please refresh the page."
msgstr "Esta fuente ha caducado. Actualiza la página."

msgid "Invalid request."
msgstr "Solicitud no válida."

# --- 3.7.0: per-feed excerpt length ---
msgid "Excerpt Length"
msgstr "Longitud del extracto"

msgid "Default Excerpt Length"
msgstr "Longitud de extracto predeterminada"

msgid "Excerpt"
msgstr "Extracto"

msgid "characters"
msgstr "caracteres"

msgid "%d chars"
msgstr "%d caracteres"

msgid "Full"
msgstr "Completo"

msgid "Number of posts to load per batch (%d-%d). Each \"Load More\" click loads another batch."
msgstr "Número de entradas a cargar por lote (%d-%d). Cada clic en «Cargar más» carga otro lote."

msgid "Maximum excerpt length for this feed, in characters (0-%d). Use 0 to show the full excerpt from the source. Default: %d."
msgstr "Longitud máxima del extracto para esta fuente, en caracteres (0-%d). Usa 0 para mostrar el extracto completo de la fuente. Predeterminado: %d."

msgid "Default maximum excerpt length, in characters (0-%1$d). Use 0 to show the full excerpt from the source. Default: %2$d. Each feed source can override this."
msgstr "Longitud máxima del extracto predeterminada, en caracteres (0-%1$d). Usa 0 para mostrar el extracto completo de la fuente. Predeterminado: %2$d. Cada fuente puede sobrescribirla."

# --- Demo feed ---
msgid "ProWoos Demo Feed"
msgstr "Feed de demostración de ProWoos"

msgid "Demo feed."
msgstr "Feed de demostración."

msgid "These sample posts come from ProWoos and are shown for demonstration only."
msgstr "Estas entradas de ejemplo proceden de ProWoos y se muestran solo como demostración."

msgid "Settings → REST Posts Embedder"
msgstr "Ajustes → REST Posts Embedder"

#. translators: %s: link to the plugin settings page.
msgid "To show your own posts, add a feed source in %s and use the shortcode shown for it."
msgstr "Para mostrar tus propias entradas, añade una fuente en %s y usa el shortcode que aparece para ella."

msgid "Only administrators see this notice."
msgstr "Solo los administradores ven este aviso."

msgid "About the Demo Feed"
msgstr "Acerca del feed de demostración"

msgid "The plugin comes with a demo feed of posts from ProWoos, so you can see how embedded posts look right after activation. It is for demonstration only. Sources that use it are marked \"Demo\" below."
msgstr "El plugin incluye un feed de demostración con entradas de ProWoos, para que veas cómo quedan las entradas incrustadas nada más activarlo. Es solo una demostración. Las fuentes que lo usan aparecen marcadas como «Demo» más abajo."

msgid "To show your own posts:"
msgstr "Para mostrar tus propias entradas:"

msgid "Add New Source"
msgstr "Añadir nueva fuente"

msgid "Click \"Add New Source\", or edit the demo source."
msgstr "Haz clic en «Añadir nueva fuente» o edita la fuente de demostración."

msgid "Enter the REST API endpoint of the site whose posts you want to show (see the examples on this page) and save."
msgstr "Introduce el endpoint de la API REST del sitio cuyas entradas quieres mostrar (consulta los ejemplos de esta página) y guarda."

#. translators: %s: example shortcode.
msgid "Place the shortcode shown for that source on any page, for example %s."
msgstr "Coloca en cualquier página el shortcode que aparece para esa fuente, por ejemplo %s."

#. translators: %s: the shortcode without attributes.
msgid "The shortcode without a source, %s, always shows the demo feed."
msgstr "El shortcode sin fuente, %s, siempre muestra el feed de demostración."

msgid "Demo"
msgstr "Demo"

msgid "This is the ProWoos demo feed. Replace it with the endpoint of the site whose posts you want to show."
msgstr "Este es el feed de demostración de ProWoos. Sustitúyelo por el endpoint del sitio cuyas entradas quieres mostrar."
